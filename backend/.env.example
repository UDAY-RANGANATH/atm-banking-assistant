# AI Provider Configuration (Phase 7)
AI_PROVIDER=mock            # mock | openai_compatible
AI_API_KEY=                 # server-side only; never exposed to the frontend
AI_BASE_URL=                # e.g. https://api.openai.com/v1
AI_MODEL=                   # model identifier requested from the provider
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1
AI_RATE_LIMIT_COOLDOWN=10
AI_MAX_MESSAGE_LENGTH=500
AI_HISTORY_TURNS=10

# Application Configuration
APP_NAME=AI Banking Assistant
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=dev-secret-change-in-production

SERVE_FRONTEND_DIST=0            # 1 = serve built frontend/dist via FastAPI (single-origin deployment)
FRONTEND_DIST_PATH=../frontend/dist

# Session Configuration
SESSION_TIMEOUT_MINUTES=30
